# Токен бота от @BotFather
REELS_TELEGRAM_TOKEN=
# Ключ Anthropic API — без него работают эвристики (без описаний кадров и правок текстом)
ANTHROPIC_API_KEY=
# Для локального сервера Bot API (docker-compose): https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Необязательные настройки (значения по умолчанию)
# REELS_LLM_PLANNER_MODEL=claude-opus-5
# REELS_LLM_VISION_MODEL=claude-haiku-4-5
# REELS_DEFAULT_DURATION_S=20
# REELS_STORYBOARD_APPROVAL=true
# REELS_WHISPER_MODEL=small
# REELS_SPEECH_ENABLED=true
# REELS_DATABASE_URL=postgresql+asyncpg://user:pass@host/db
